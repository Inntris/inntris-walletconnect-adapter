# ---------------------------------------------------------------------------
# Inntris Core — the authority. Required for every gated operation.
# The `info` path deliberately does not read any of these.
# ---------------------------------------------------------------------------
INNTRIS_CORE_URL=https://api.inntris.com
INNTRIS_AGENT_ID=00000000-0000-0000-0000-000000000000
# Base64 Ed25519 seed, 32 bytes. Never passed to the downstream wallet process.
INNTRIS_PRIVATE_KEY_B64=

# Per-call cap on each Core request. Fixed: it does not grow with the
# invocation deadline, so a 179s send-transaction ceiling still gives /verify
# 2.5s. Default 2500.
INNTRIS_CORE_TIMEOUT_MS=2500

# Optional operator cap on the whole invocation, applied on top of the caller's
# per-operation ceiling. Unset by default. Setting this below what an operation
# legitimately needs will manufacture timeouts.
# INNTRIS_MAX_INVOCATION_MS=

# ---------------------------------------------------------------------------
# Downstream CWP wallet provider
# ---------------------------------------------------------------------------
# Absolute path, must exist and be executable, and must not be wallet-inntris.
INNTRIS_DOWNSTREAM_WALLET_BIN=/absolute/path/to/wallet-companion
INNTRIS_DOWNSTREAM_PROVIDER_NAME=companion

# Optional cap on the downstream slice. Defaults to whatever the invocation
# deadline has left at spawn time.
# INNTRIS_DOWNSTREAM_TIMEOUT_MS=

# Descriptor used when the downstream `info` call cannot be resolved. Without
# it, an unreachable downstream makes wallet-inntris fail discovery instead of
# degrading. Capabilities are intersected with what the shim can route, on this
# path as on every other.
# INNTRIS_DOWNSTREAM_INFO_FALLBACK={"capabilities":["accounts","send-transaction"],"chains":["eip155:8453"]}

# Where the resolved downstream descriptor is cached (mode 0600). Keyed on the
# binary path, its mtime, and the adapter version.
# INNTRIS_INFO_CACHE_PATH=~/.config/inntris/downstream-info.json

# ---------------------------------------------------------------------------
# Bypass protection (§11)
# ---------------------------------------------------------------------------
# When false (the default), wallet-inntris refuses to delegate if the downstream
# wallet-* binary is itself discoverable on PATH — CWP discovery would reach it
# without traversing Inntris. This is a configuration guard, not an OS boundary.
INNTRIS_ALLOW_DISCOVERABLE_DOWNSTREAM=false

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
INNTRIS_RECEIPT_BASE_URL=https://inntris.com/verify

# The WalletConnect CLI drains provider stderr and discards it. Set this to
# mirror the [inntris] diagnostics — including the decision and consumption
# receipt URLs — to a file as well.
# INNTRIS_AUDIT_LOG=/var/log/inntris/wallet-inntris.log
